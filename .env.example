# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string (optional; falls back to encrypted local vault store if unset).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/amanah_coop?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing HttpOnly JWT authentication cookies.
JWT_SECRET="change-this-to-a-strong-random-64-char-secret"

# ENCRYPTION_KEY: 32-byte hex key (64 hex chars) for AES-256-GCM encryption of sensitive financial records.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
